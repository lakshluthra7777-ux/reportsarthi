# Copy this file to .env and fill in real values.
# Never commit .env to Git.
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-api-key-here
SECRET_KEY=change-this-to-any-random-text

# Optional: open the app from phones on the same Wi-Fi (for doctor share QR codes).
# Find your PC's IP with "ipconfig" (IPv4 Address), then:
# HOST=0.0.0.0
# PUBLIC_URL=http://192.168.1.5:5000
